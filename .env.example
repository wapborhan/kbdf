# Local MongoDB (all data lives in the "kbdfDB" database). For Vercel use a MongoDB Atlas URI instead.
MONGODB_URI=mongodb://localhost:27017/kbdfDB

# Firebase web app config (Project settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Comma-separated Google emails that become admin (auto-approved) on login
ADMIN_EMAILS=admin@example.com

# Public site URL (used for SEO canonical/OG/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service account (Project settings > Service accounts > Generate key). Keep the \n escapes in the private key.
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwgg...==\n-----END PRIVATE KEY-----\n"
